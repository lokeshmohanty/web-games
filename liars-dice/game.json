      "glyph": "🤖",
      "when": {
        "won": true,
        "bots": {
          ">=": 3
        }
      }
    },
    {
      "id": "full-table",
      "title": "Full Table",
      "description": "Win against 5 bots.",
      "glyph": "👑",
      "when": {
        "won": true,
        "bots": {
          ">=": 5
        }
      }
    },
    {
      "id": "comeback",
      "title": "Comeback",
      "description": "Win after being down to your last die.",
      "glyph": "🔄",
      "when": {
        "won": true,
        "facts.lowest": 1
      }
    },
    {
      "id": "untouched",
      "title": "Untouched",
      "description": "Win without losing a die.",
      "glyph": "🛡️",
