{
  "sdk": 2,
  "state": "managed",
  "id": "ludo",
  "name": "LUDO",
  "title": "Ludo",
  "blurb": "Roll a 6 to leave the yard, race your four tokens home, send rivals back. 4- or 6-player board, teams too.",
  "description": "Classic Ludo: a 6 to leave the yard and a 6 rolls again, three 6s lose the turn, land on a token to send it home, stars are safe, an exact roll to go home. A 4-player board and a 6-player board, free-for-all or in teams. Two to six players; bots fill seats if you want them.",
  "entry": "index.html",
  "rules": "RULES.md",
  "shape": "free",
  "seats": {
    "min": 2,
    "max": 6
  },
  "bots": true,
  "kind": "ffa",
  "tags": [
    "alone",
    "party",
    "dice"
  ],
  "categories": [
    "party"
  ],
  "preview": "preview.gif",
  "records": [
    {
      "id": "captures",
      "title": "Most captures in a game",
      "of": "facts.captures",
      "best": "max"
    },
    {
      "id": "captured",
      "title": "Tokens sent home in all",
      "of": "facts.captures",
      "best": "sum"
    }
  ],
  "achievements": [
    {
      "id": "first-win",
      "title": "First Win",
      "description": "Win a game of Ludo.",
      "glyph": "🏁",
      "when": {
        "won": true
      }
    },
    {
      "id": "beat-3",
      "title": "Beat 3 Bots",
      "description": "Win against 3 or more bots.",
      "glyph": "🤖",
      "when": {
        "won": true,
        "bots": {
          ">=": 3
        }
      }
    },
    {
      "id": "full-board",
      "title": "Full Board",
      "description": "Win against 5 bots on the six-player board.",
      "glyph": "👑",
      "when": {
        "won": true,
        "bots": {
          ">=": 5
        }
      }
    },
    {
      "id": "hunter",
      "title": "Hunter",
      "description": "Send 3 tokens home in one game.",
      "glyph": "🎯",
      "when": {
        "facts.captures": {
          ">=": 3
        }
      }
    },
    {
      "id": "untouchable",
      "title": "Untouchable",
      "description": "Win without losing a token.",
      "glyph": "🛡️",
      "when": {
        "won": true,
        "facts.finished": true,
        "facts.lost": 0
      }
    },
    {
      "id": "team-player",
      "title": "Team Player",
      "description": "Win a teams game.",
      "glyph": "🤝",
      "when": {
        "won": true,
        "facts.finished": true,
        "kind": "teams"
      }
    },
    {
      "id": "hat-trick",
      "title": "Hat Trick",
      "description": "Win 3 games in a row.",
      "glyph": "🎩",
      "when": {
        "won": true
      },
      "streak": 3
    },
    {
      "id": "ten-wins",
      "title": "Ten Wins",
      "description": "Win 10 games.",
      "glyph": "🏆",
      "when": {
        "won": true
      },
      "count": 10
    }
  ],
